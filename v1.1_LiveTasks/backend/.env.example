# Backend LiveTasks - Variables de Entorno
# Copia este archivo a .env y completa los valores

PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/livetasks

# JWT
JWT_SECRET=cambia_este_secreto_super_seguro
JWT_REFRESH_SECRET=cambia_este_secreto_refresh_seguro
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4200/auth/google/callback

# Google Gemini AI
GEMINI_API_KEY=

# CORS
CLIENT_ORIGIN=http://localhost:4200
