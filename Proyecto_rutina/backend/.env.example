# ─────────────────────────────────────────────────────────────
# Proyecto Rutina - Backend
# Copia este archivo como `.env` y ajusta los valores.
# ─────────────────────────────────────────────────────────────

# Servidor
NODE_ENV=development
PORT=3000

# Cliente permitido (CORS). Varios orígenes separados por coma.
CORS_ORIGINS=http://localhost:4200

# Base de datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=proyecto_rutina

# TypeORM: en desarrollo crea/esquema automáticamente desde las entidades.
# En producción usa `false` y ejecuta `db/schema.sql` manualmente.
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Autenticación JWT (el token de acceso expira, el refresh gira y se guarda en BD)
JWT_SECRET=cambia-este-secreto-por-una-cadena-larga-y-aleatoria
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Enlaces de integraciones futuras (opcional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=