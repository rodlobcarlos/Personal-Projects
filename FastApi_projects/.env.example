# ---------------------------------------------------------------------------
# Copia este fichero a .env y ajusta los valores:  cp .env.example .env
# Nunca subas el fichero .env real al repositorio.
# ---------------------------------------------------------------------------

# --- Aplicacion ------------------------------------------------------------
PROJECT_NAME=Projects API
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=projects_db
# Si la defines, tiene prioridad sobre las variables POSTGRES_*
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/projects_db
SQL_ECHO=false

# --- Seguridad -------------------------------------------------------------
# Genera una clave segura con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esta-clave-por-una-segura-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# --- Usuario administrador inicial (seed) ----------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!

# --- CORS ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:4200
